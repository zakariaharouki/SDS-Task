#!/bin/sh
# Blocks any push whose commits contain a .env file, including one added with `git add -f`.
# .env.example is allowed. Enable once per clone: git config core.hooksPath .githooks

remote="$1"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote branch sends no commits.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    # Commits this remote does not have yet.
    for commit in $(git rev-list "$local_sha" --not --remotes="$remote"); do
        files=$(git ls-tree -r --name-only "$commit" \
            | grep -E '(^|/)\.env(\.[^/]*)?$' \
            | grep -Ev '(^|/)\.env\.example$')

        if [ -n "$files" ]; then
            echo "pre-push: BLOCKED. Commit $commit on $local_ref contains:" >&2
            echo "$files" | sed 's/^/  /' >&2
            blocked=1
        fi
    done
done

if [ "$blocked" -ne 0 ]; then
    echo "pre-push: remove the .env file from these commits before pushing." >&2
    exit 1
fi

exit 0
